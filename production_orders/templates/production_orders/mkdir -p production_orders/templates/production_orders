<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Production Order {{ order.order_number }}
    </title>

    <style>

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
        }

        body {
            font-family:
                Arial,
                Helvetica,
                sans-serif;

            background: #f3f4f6;

            color: #111;

            font-size: 13px;
        }


        /* ==================================================
           PAGE
        ================================================== */

        .page {
            width: 210mm;

            min-height: 297mm;

            margin: 20px auto;

            padding: 18mm;

            background: #fff;

            box-shadow:
                0 2px 12px rgba(
                    0,
                    0,
                    0,
                    0.08
                );
        }


        /* ==================================================
           PRINT BUTTON
        ================================================== */

        .print-button {
            position: fixed;

            top: 20px;

            right: 20px;

            z-index: 1000;

            padding: 10px 18px;

            border: none;

            border-radius: 5px;

            background: #111;

            color: #fff;

            font-size: 12px;

            font-weight: 700;

            cursor: pointer;
        }

        .print-button:hover {
            opacity: 0.85;
        }


        /* ==================================================
           HEADER
        ================================================== */

        .header {
            display: flex;

            justify-content: space-between;

            align-items: flex-start;

            gap: 30px;

            margin-bottom: 32px;

            padding-bottom: 20px;

            border-bottom: 2px solid #111;
        }

        .company {
            flex: 1;
        }

        .company-name {
            font-size: 24px;

            font-weight: 700;

            letter-spacing: 0.3px;
        }

        .company-details {
            margin-top: 8px;

            color: #555;

            font-size: 11px;

            line-height: 1.7;
        }

        .document-title {
            min-width: 200px;

            text-align: right;
        }

        .document-title h1 {
            margin: 0;

            font-size: 26px;

            letter-spacing: 1px;
        }

        .document-number {
            margin-top: 7px;

            font-size: 13px;

            font-weight: 700;
        }

        .status {
            display: inline-block;

            margin-top: 9px;

            padding: 5px 10px;

            border: 1px solid #111;

            font-size: 10px;

            font-weight: 700;

            letter-spacing: 0.5px;
        }


        /* ==================================================
           SECTIONS
        ================================================== */

        .section {
            margin-bottom: 25px;
        }

        .section-title {
            margin-bottom: 10px;

            padding-bottom: 6px;

            border-bottom: 1px solid #ddd;

            font-size: 11px;

            font-weight: 700;

            text-transform: uppercase;

            letter-spacing: 0.5px;
        }


        /* ==================================================
           INFO
        ================================================== */

        .info-grid {
            display: grid;

            grid-template-columns:
                1fr 1fr;

            gap: 15px 30px;
        }

        .info-box {
            font-size: 12px;

            line-height: 1.8;
        }

        .label {
            font-weight: 700;
        }


        /* ==================================================
           TABLE
        ================================================== */

        table {
            width: 100%;

            border-collapse: collapse;

            margin-top: 10px;
        }

        thead {
            display: table-header-group;
        }

        th {
            padding: 9px 8px;

            background: #f2f2f2;

            border: 1px solid #d8d8d8;

            font-size: 10px;

            font-weight: 700;

            text-align: left;

            text-transform: uppercase;
        }

        td {
            padding: 10px 8px;

            border: 1px solid #d8d8d8;

            font-size: 11px;

            vertical-align: top;
        }

        tbody tr {
            page-break-inside: avoid;
        }

        .center {
            text-align: center;
        }

        .right {
            text-align: right;
        }


        /* ==================================================
           REMARK
        ================================================== */

        .remark {
            margin-top: 30px;

            padding: 12px;

            border: 1px solid #ddd;

            font-size: 11px;

            line-height: 1.7;
        }

        .remark-title {
            margin-bottom: 5px;

            font-size: 10px;

            font-weight: 700;

            text-transform: uppercase;
        }


        /* ==================================================
           SIGNATURES
        ================================================== */

        .signature-section {
            display: flex;

            justify-content: space-between;

            gap: 40px;

            margin-top: 75px;
        }

        .signature {
            width: 220px;

            padding-top: 35px;

            border-top: 1px solid #111;

            font-size: 11px;
        }


        /* ==================================================
           FOOTER
        ================================================== */

        .footer {
            display: flex;

            justify-content: space-between;

            gap: 20px;

            margin-top: 60px;

            padding-top: 10px;

            border-top: 1px solid #ddd;

            color: #666;

            font-size: 9px;
        }


        /* ==================================================
           PRINT
        ================================================== */

        @media print {

            html,
            body {
                background: #fff;
            }

            .page {
                width: 100%;

                min-height: auto;

                margin: 0;

                padding: 18mm;

                box-shadow: none;
            }

            .print-button {
                display: none !important;
            }

            .section {
                break-inside: avoid;
            }

            .remark {
                break-inside: avoid;
            }

            .signature-section {
                break-inside: avoid;
            }
        }


        @page {
            size: A4;

            margin: 0;
        }

    </style>

</head>


<body>


<button
    class="print-button"
    onclick="window.print()"
>
    Print Production Order
</button>


<div class="page">


    <!-- =================================================
         HEADER
    ================================================== -->

    <div class="header">

        <div class="company">

            <div class="company-name">
                STRONG ALUMINIUM COMPANY LIMITED
            </div>

            <div class="company-details">

                Idu Industrial Area<br>

                Abuja, Nigeria<br>

                Phone: +234 806 038 8983<br>

                Email: strongzincltd@gmail.com

            </div>

        </div>


        <div class="document-title">

            <h1>
                PRODUCTION ORDER
            </h1>

            <div class="document-number">
                {{ order.order_number }}
            </div>

            {% if order.approved %}

                <div class="status">
                    APPROVED
                </div>

            {% endif %}

        </div>

    </div>


    <!-- =================================================
         ORDER INFORMATION
    ================================================== -->

    <div class="section">

        <div class="section-title">
            Order Information
        </div>

        <div class="info-grid">

            <div class="info-box">

                <span class="label">
                    Production Order:
                </span>

                {{ order.order_number }}

                <br>

                <span class="label">
                    Quotation:
                </span>

                {% if order.quotation %}
                    {{ order.quotation.quotation_number }}
                {% else %}
                    -
                {% endif %}

                <br>

                <span class="label">
                    Date:
                </span>

                {{ order.created_at|date:"d M Y" }}

                <br>

                <span class="label">
                    Status:
                </span>

                {% if order.approved %}
                    Approved
                {% else %}
                    Pending Approval
                {% endif %}

            </div>


            <div class="info-box">

                <span class="label">
                    Customer:
                </span>

                {{ order.customer.name|default:"-" }}

                {% if order.customer.company_name %}

                    <br>

                    <span class="label">
                        Company:
                    </span>

                    {{ order.customer.company_name }}

                {% endif %}

                <br>

                <span class="label">
                    Phone:
                </span>

                {{ order.customer.phone|default:"-" }}

            </div>

        </div>

    </div>


    <!-- =================================================
         PRODUCTION DETAILS
    ================================================== -->

    <div class="section">

        <div class="section-title">
            Production Details
        </div>

        <table>

            <thead>

                <tr>

                    <th>
                        Product
                    </th>

                    <th>
                        Marketer
                    </th>

                    <th class="center">
                        Meter Run
                    </th>

                    <th class="center">
                        Bundles
                    </th>

                    <th class="center">
                        Length
                    </th>

                </tr>

            </thead>


            <tbody>

                <tr>

                    <td>
                        {{ order.product.name|default:"-" }}
                    </td>

                    <td>
                        {{ order.marketer_name|default:"-" }}
                    </td>

                    <td class="center">
                        {{ order.meter_run|default:"-" }}
                    </td>

                    <td class="center">
                        {{ order.bundles|default:"-" }}
                    </td>

                    <td class="center">
                        {{ order.length|default:"-" }}
                    </td>

                </tr>

            </tbody>

        </table>

    </div>


    <!-- =================================================
         REMARK
    ================================================== -->

    {% if order.remark %}

    <div class="remark">

        <div class="remark-title">
            Production Remark
        </div>

        {{ order.remark }}

    </div>

    {% endif %}


    <!-- =================================================
         SIGNATURES
    ================================================== -->

    <div class="signature-section">

        <div class="signature">
            Prepared / Processed By
        </div>

        <div class="signature">
            Accountant Approval
        </div>

    </div>


    <!-- =================================================
         FOOTER
    ================================================== -->

    <div class="footer">

        <div>
            Strong Aluminium Company Limited
        </div>

        <div>
            {{ order.order_number }}
        </div>

        <div>
            Generated from Invoice Management System
        </div>

    </div>


</div>


<script>

    window.addEventListener(
        "load",
        function () {

            setTimeout(
                function () {
                    window.print();
                },
                300
            );

        }
    );

</script>


</body>

</html>